# Example nginx reverse proxy for the GWSC private backend.
# Replace gwsc.example.com and certificate paths with your own values.

upstream gwsc_api {
    server 127.0.0.1:8443;
    keepalive 32;
}

server {
    listen 80;
    server_name gwsc.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name gwsc.example.com;

    ssl_certificate     /etc/letsencrypt/live/gwsc.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/gwsc.example.com/privkey.pem;

    client_max_body_size 2m;

    location / {
        proxy_pass http://gwsc_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_buffering off;
    }

    # SSE requires unbuffered responses.
    location /gwsc/api/events {
        proxy_pass http://gwsc_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
    }
}

# UDP is not proxied by nginx. Open the relay port directly in the firewall:
#   ufw allow 6672/udp
