# Example /etc/gwsc/gwsc.env for a systemd deployment.
GWSC_ENV=production
GWSC_HOST=127.0.0.1
GWSC_PORT=8443
GWSC_SSL_ENABLED=false
GWSC_TRUST_PROXY=true
GWSC_DOCS_ENABLED=false
GWSC_CAPTURE_ENABLED=false
GWSC_SERVER_NAME=Unknown Beaches Social Club
GWSC_PUBLIC_HOST=gwsc.example.com
DATA_DIR=/var/lib/gwsc
GWSC_LOG_DIR=/var/log/gwsc
GWSC_BACKUP_DIR=/var/backups/gwsc
GWSC_ALLOWED_ORIGINS=*
GWSC_REGISTRATION=true
