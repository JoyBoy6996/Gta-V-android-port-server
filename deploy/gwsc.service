[Unit]
Description=GWSC private backend for the GTA V Android port
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gwsc
Group=gwsc
WorkingDirectory=/opt/gwsc
EnvironmentFile=/etc/gwsc/gwsc.env
ExecStart=/opt/gwsc/.venv/bin/python -m gwsc_local_termux.server
Restart=on-failure
RestartSec=5
TimeoutStopSec=20

# Basic hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/gwsc /var/log/gwsc /var/backups/gwsc
AmbientCapabilities=
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
