# Copy to .env (never commit .env) or export these variables.
# Every value is optional; the defaults are suitable for local Termux use.

# development | production
GWSC_ENV=development

# Identity / network
GWSC_SERVER_NAME=Unknown Beaches Social Club
GWSC_SERVER_VERSION=1.0.0
GWSC_HOST=0.0.0.0
GWSC_PORT=8443
GWSC_RELAY_HOST=0.0.0.0
GWSC_RELAY_PORT=6672
# Public UDP relay advertised by GetRelayServers (host:port are separate).
GWSC_RELAY_PUBLIC_ADDRESS=
GWSC_RELAY_PUBLIC_PORT=6672
# Public hostname advertised to remote matchmaking clients (no scheme/port).
GWSC_PUBLIC_HOST=

# TLS (leave disabled when a reverse proxy terminates TLS)
GWSC_SSL_ENABLED=true
GWSC_SSL_CERT=cert.pem
GWSC_SSL_KEY=key.pem

# Storage
DATA_DIR=
GWSC_DB_NAME=gwsc.db
GWSC_LOG_DIR=
GWSC_BACKUP_DIR=

# Static asset redirects: HTTPS base URLs only, with allowlisted hostnames.
# Leaving a target empty makes that redirect route return 404.
# GWSC_STATIC_REDIRECT_PROD_CLOUD=https://assets.example.invalid
# GWSC_STATIC_REDIRECT_TUNABLES=https://tunables.example.invalid
# GWSC_STATIC_REDIRECT_ROS=https://ros.example.invalid
# GWSC_STATIC_REDIRECT_ALLOWED_HOSTS=assets.example.invalid,tunables.example.invalid,ros.example.invalid

# Accounts / sessions
GWSC_REGISTRATION=true
GWSC_PASSWORD_MIN_LENGTH=8
GWSC_TOKEN_EXPIRY=86400
# Optional extra secret mixed into token hashes. Keep stable after deployment.
GWSC_TOKEN_PEPPER=
GWSC_PBKDF2_ITERATIONS=600000

# Presence / sessions
GWSC_PRESENCE_TIMEOUT=300
GWSC_SESSION_TIMEOUT=300
GWSC_TICKET_EXPIRY=3600

# Discord: external bot process only. FastAPI never reads DISCORD_TOKEN.
GWSC_DISCORD_ENABLED=false
# GWSC_DISCORD_GUILD_ID=
GWSC_DISCORD_PLAYER_WINDOW_SECONDS=600
GWSC_DISCORD_STATUS_INTERVAL_SECONDS=60

# Native service-host redirect (leave empty to use the launcher's -rosHost=)
# GWSC_NATIVE_SERVICE_HOST=your-public-host:8443
# GWSC_NATIVE_SERVICE_EP=*
GWSC_NATIVE_MATCHMAKING_SESSION_SECONDS=28800
GWSC_P2P_CERT_TTL=86400
# GWSC_P2P_CERT_DIR=
# GWSC_P2P_CA_KEY=
# GWSC_P2P_CA_CERT=

# Abuse limits
GWSC_LOGIN_RATE_LIMIT=10
GWSC_LOGIN_RATE_WINDOW=300
GWSC_REGISTER_RATE_LIMIT=5
GWSC_REGISTER_RATE_WINDOW=3600
GWSC_MESSAGE_RATE_LIMIT=30
GWSC_MESSAGE_RATE_WINDOW=60
GWSC_MAX_BODY_BYTES=1048576
# UGC Create/Update carry inline binary frames and use this larger limit.
GWSC_OBJECT_MAX_BYTES=26214400

# UGC photos: dedicated HMAC secret and public HTTPS metadata base URL.
# GWSC_PHOTO_UPLOAD_SECRET=
# GWSC_UGC_PUBLIC_BASE_URL=https://cdn.example.invalid

# Relay
GWSC_RELAY_MAX_DATAGRAM=2048
GWSC_RELAY_PEER_TIMEOUT=60
GWSC_RELAY_RATE_PPS=200
GWSC_RELAY_RATE_BURST=400
GWSC_RELAY_MAX_PEERS_PER_SESSION=32
# GWSC_RELAY_CERT_DIR=
# GWSC_RELAY_SIGNING_KEY=
# GWSC_RELAY_PUBLIC_KEY_DER=
# GWSC_RELAY_PUBLIC_KEY_PEM=
# GWSC_RELAY_PUBLIC_KEY_TXT=

# Economy: shark card claims are a private-development opt-in only.
GWSC_ALLOW_SHARKCARD_CLAIMS=false
GWSC_STARTER_PACK_AMOUNT=1000000

# Development capture (never enabled in production)
GWSC_CAPTURE_ENABLED=false
GWSC_CAPTURE_DIR=
GWSC_CAPTURE_MAX_BODY=65536

# Web
GWSC_ALLOWED_ORIGINS=*
GWSC_TRUST_PROXY=false
GWSC_DOCS_ENABLED=true
GWSC_DEBUG_ENDPOINTS=false
